# Neon via Vercel Storage. Vercel injects these on Production;
# locally, copy them from Storage → .env
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/verceldb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/verceldb?sslmode=require

# Open-source Codex (gpt-oss). Endpoint + few-shots live in the `ai` database.
# Keep the API key here — never in Postgres.
# NLU_PROVIDER=codex
# NLU_MODEL=openai/gpt-oss-20b
# NLU_BASE_URL=https://router.huggingface.co/v1
# NLU_API_KEY=
